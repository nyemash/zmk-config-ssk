#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define COMMON 1
#define FIXRALT 2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC     &kp F1    &kp F2     &kp F3         &kp F4       &kp F5    &kp F6    &kp F7     &kp F8     &kp F9   &kp F10   &kp F11    &kp F12    &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK
&kp GRAVE   &kp N1    &kp N2     &kp N3         &kp N4       &kp N5    &kp N6    &kp N7     &kp N8     &kp N9   &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC   &kp INS   &kp HOME         &kp PG_UP
&kp TAB     &kp Q     &kp W      &kp E          &kp R        &kp T     &kp Y     &kp U      &kp I      &kp O    &kp P     &kp LBKT   &kp RBKT   &kp BSLH   &kp DEL   &kp END          &kp PG_DN
&lt 1 LWIN  &kp A     &kp S      &kp D          &kp F        &kp G     &kp H     &kp J      &kp K      &kp L    &kp SEMI  &kp APOS   &kp ENTER
&kp LSHFT   &kp Z     &kp X      &kp C          &kp V        &kp B     &kp N     &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT  &kp UP
&kp LCTRL   &kp LALT  &kp SPACE  &kp RIGHT_ALT  &lt 2 K_APP  &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        common_layer {
            bindings = <
&none           &none           &none           &none           &none           &none         &none         &none          &none       &none       &none       &none     &none           &out OUT_TOG      &kp LC(LA(F11))  &kp LC(LA(F12))
&kp LC(LA(F1))  &kp C_VOL_DN    &kp C_VOL_UP    &kp C_MUTE      &none           &none         &none         &none          &none       &none       &none       &none     &none           &kp LC(LA(BSPC))  &bootloader      &kp HOME         &bt BT_NXT
&none           &kp LA(F4)      &kp LC(W)       &kp LG(E)       &kp LG(R)       &none         &none         &kp LG(U)      &kp LG(I)   &none       &kp LG(P)   &none     &none           &kp LC(LA(F10))   &bt BT_CLR       &kp END          &bt BT_PRV
&none           &kp LG(A)       &kp LG(S)       &kp LG(D)       &kp LC(LA(F))   &none         &none         &none          &none       &kp LG(L)   &none       &none     &kp LC(LA(F9))
&kp LC(LA(F3))  &kp LS(LG(S))   &kp LG(X)       &kp LG(C)       &kp LG(V)       &none         &none         &none          &kp C_PREV  &kp C_NEXT  &kp C_PLAY  &kp CAPS  &kp LG(UP)
&kp LC(LA(F4))  &kp LC(LA(F5))  &kp LC(LA(F6))  &kp LC(LA(F7))  &kp LC(LA(F8))  &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(RIGHT)
            >;
        };

        others {
            bindings = <
&none  &none  &none  &none  &none  &none     &none      &none    &none  &none  &none  &none  &none      &none  &none  &none
&none  &none  &none  &none  &none  &none     &none      &none    &none  &none  &none  &none  &none      &none  &none  &none  &none
&none  &none  &none  &none  &none  &none     &none      &none    &none  &none  &none  &none  &none      &none  &none  &none  &none
&none  &none  &none  &none  &none  &none     &none      &none    &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none     &none      &none    &none  &none  &none  &none  &kp PG_UP
&none  &none  &none  &none  &none  &kp HOME  &kp PG_DN  &kp END
            >;
        };
    };
};
